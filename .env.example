# Astra 环境配置模板
# 复制此文件为 .env 并填入实际值
# 模型权重目录 — 指向包含 safetensors / config.json 的本地路径
# Windows 示例: ASTRA_MODEL_DIR=C:/Users/Qchau/models/DeepSeek-V4-Flash
# WSL 示例:    ASTRA_MODEL_DIR=/home/chauncey/models/DeepSeek-V4-Flash  
# Linux 示例:   ASTRA_MODEL_DIR=/opt/astra/models/deepseek-v4-flash
ASTRA_MODEL_DIR=

# 推理后端
# 留空 = numpy stub (开发/测试)
# MXFP4  = KTransformers CPU 推理 (DeepSeek-V4-Flash)
ASTRA_KT_METHOD=

# 是否使用 GPU
ASTRA_USE_KTRANSFORMERS=0

# DHT 引导节点
ASTRA_DHT_BOOTSTRAP=

# 日志级别: DEBUG, INFO, WARNING, ERROR
ASTRA_LOG_LEVEL=INFO