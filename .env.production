# Astra 生产环境配置
# 警告：此文件包含敏感信息，请勿提交到公共仓库
# 此文件应仅在部署服务器上存在，通过环境变量或 secrets manager 注入

# ── 运行环境 ────────────────────────────────────────────────────────
ASTRA_ENV=production

# ── 模型权重目录 ────────────────────────────────────────────────────
# 生产服务器上的模型权重路径（safetensors / config.json）
# Linux 示例: ASTRA_MODEL_DIR=/opt/astra/models/deepseek-v4-flash
# Docker 示例: ASTRA_MODEL_DIR=/data/model
ASTRA_MODEL_DIR=/opt/astra/models/DeepSeek-V4-Flash

# ── 推理后端 ────────────────────────────────────────────────────────
# MXFP4 = KTransformers CPU 推理 (DeepSeek-V4-Flash)
ASTRA_KT_METHOD=MXFP4

# 是否使用 KTransformers 真实权重推理
ASTRA_USE_KTRANSFORMERS=1

# ── DHT 引导节点 ────────────────────────────────────────────────────
# 生产集群中 DHT seed 节点的地址
# 格式: host:port 或 ip:port（多节点用逗号分隔）
ASTRA_DHT_BOOTSTRAP=dht-seed:50050

# ── API 网关 ────────────────────────────────────────────────────────
# 生产环境建议通过反向代理（Nginx/Caddy）暴露 443，内部使用 8080
ASTRA_API_HOST=0.0.0.0
ASTRA_API_PORT=8080

# ── 安全 ────────────────────────────────────────────────────────────
# TLS 证书路径（如通过 Nginx 终止 TLS，此处置空）
# ASTRA_TLS_CERT=/etc/astra/certs/fullchain.pem
# ASTRA_TLS_KEY=/etc/astra/certs/privkey.pem

# API 密钥（如启用认证）
# ASTRA_API_KEY=  # 通过环境变量或 Docker secrets 注入，勿硬编码

# ── 日志 ────────────────────────────────────────────────────────────
# 生产环境建议 WARNING 级别，减少日志量
ASTRA_LOG_LEVEL=WARNING

# ── 资源限制 ────────────────────────────────────────────────────────
# 最大并发推理请求数
ASTRA_MAX_CONCURRENT_REQUESTS=16

# 每个请求的最大序列长度
ASTRA_MAX_SEQ_LEN=4096

# KV 缓存大小（GB），0 表示自动检测
ASTRA_KV_CACHE_SIZE_GB=0

# ── 监控 ────────────────────────────────────────────────────────────
# Prometheus metrics 端口（可选）
# ASTRA_METRICS_PORT=9090